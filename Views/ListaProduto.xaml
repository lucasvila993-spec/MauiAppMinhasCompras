<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.ListaProduto"
             Title="Minhas Compras">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Novo" Clicked="Novo_Clicked" />
    </ContentPage.ToolbarItems>

    <Grid Padding="16" RowDefinitions="Auto,Auto,*">
        <Label Text="Minhas Compras"
               FontSize="28"
               FontAttributes="Bold"
               Margin="0,0,0,12" />

        <SearchBar Grid.Row="1"
                   x:Name="BuscaBar"
                   Placeholder="Pesquisar produto..."
                   TextChanged="BuscaBar_TextChanged"
                   Margin="0,0,0,12" />

        <CollectionView Grid.Row="2"
                        x:Name="ProdutosCollection"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="20" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="Nenhum produto cadastrado."
                           FontSize="18"
                           HorizontalTextAlignment="Center" />
                    <Button Text="Cadastrar primeiro produto"
                            Clicked="Novo_Clicked"
                            Margin="0,12,0,0" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="#DDDDDD"
                            StrokeThickness="1"
                            BackgroundColor="White"
                            Padding="12"
                            Margin="0,0,0,10">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                            <Label Text="{Binding Descricao}"
                                   FontSize="19"
                                   FontAttributes="Bold"
                                   TextColor="#212121" />

                            <Label Grid.Row="1"
                                   Text="{Binding Quantidade, StringFormat='Quantidade: {0:N2}'}"
                                   TextColor="#666666"
                                   Margin="0,4,0,0" />

                            <Label Grid.Row="2"
                                   Text="{Binding Preco, StringFormat='Preço: R$ {0:N2}'}"
                                   TextColor="#512BD4"
                                   FontAttributes="Bold"
                                   Margin="0,4,0,0" />

                            <VerticalStackLayout Grid.Column="1"
                                                 Grid.RowSpan="3"
                                                 Spacing="6">
                                <Button Text="Editar"
                                        Clicked="Editar_Clicked"
                                        CommandParameter="{Binding .}"
                                        Padding="14,6"
                                        BackgroundColor="#512BD4"
                                        TextColor="White" />
                                <Button Text="Excluir"
                                        Clicked="Excluir_Clicked"
                                        CommandParameter="{Binding .}"
                                        Padding="14,6"
                                        BackgroundColor="#D9534F"
                                        TextColor="White" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
